      {
        "id": "Cards",
        "type": "Int",
        "kind": "formula",
        "formula": "len($Player_Cards)"
      },
      {
        "id": "Autographs",
        "type": "Any",
        "kind": "formula",
        "formula": "len([c for c in $Player_Cards if c.Subset.Autograph])"
      },
      {
        "id": "Memorabilia",
        "type": "Any",
        "kind": "formula",
        "formula": "len([c for c in $Player_Cards if c.Subset.Memorabilia])"
      },
      {
        "id": "Case_Hits",
        "type": "Any",
        "kind": "formula",
        "label": "Case Hits",
        "formula": "len([c for c in $Player_Cards if c.Subset.SSP])"
      },
      {
        "id": "Value",
        "type": "Any",
        "kind": "empty"
      },
      {
        "id": "Rookie",
        "type": "Bool",
        "kind": "data"
      },
      {
        "id": "One_of_Ones",
        "type": "Any",
        "kind": "formula",
        "label": "One of Ones",
        "formula": "SUM(len(c.One_of_Ones) for c in $Player_Cards)"
      },
      {
        "id": "Player_Cards",
        "type": "RefList:Cards",
        "kind": "formula",
        "label": "Player Cards",
        "formula": "Cards.lookupRecords(Players=CONTAINS($id))",
        "show_column": "Card_Key"
      }
    ]
  },
  "access_rules": [
    {
      "table": "*",
      "columns": "*",
      "condition": "user.Access != OWNER",
      "permissions": "-S"
    },
    {
      "table": "*",
      "columns": "*",
      "condition": "user.Access != OWNER",
      "permissions": "+R-CUD"
    },
    {
      "table": "*SPECIAL",
      "columns": "SeedRule",
      "condition": "user.Access in [OWNER]",
      "permissions": "+CRUD"
    },
    {
      "table": "Pulls",
      "columns": "*",
      "condition": "user.Access != OWNER and newRec.Forever_Home",
      "permissions": "-C",
      "memo": "Forever Home text is no longer accepted. Use the Off market toggle instead."
    },
    {
      "table": "Pulls",
      "columns": "*",
      "condition": "user.Access in [EDITOR, OWNER]",
      "permissions": "+CRUD"
    },
    {
      "table": "Players",
      "columns": "Value",
      "condition": "user.Access != OWNER",
      "permissions": "-RU"
    },
    {
      "table": "Pulls",
      "columns": "Card_Key,Parallel_Key,Reported_At,Forever_Home",
      "condition": "user.Access != OWNER",
      "permissions": "-U",
      "memo": "A logged pull can't be changed. To fix a mistake, mark it not pulled and log it again."
    }
  ],
