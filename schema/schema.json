    "Cards": [
      {
        "id": "Card_Key",
        "type": "Text",
        "kind": "formula",
        "label": "Card Key",
        "formula": "\"%s #%s\" % ($Subset.Subset, $Card_Number)"
      },
      {
        "id": "Subset",
        "type": "Ref:Subsets",
        "kind": "data",
        "show_column": "Subset",
        "widget_options": {
          "widget": "Reference",
          "alignment": "left"
        }
      },
      {
        "id": "Card_Number",
        "type": "Int",
        "kind": "data",
        "label": "Card Number",
        "widget_options": {
          "widget": "TextBox",
          "alignment": "right",
          "decimals": 0
        }
      },
      {
        "id": "Players",
        "type": "RefList:Players",
        "kind": "formula",
        "formula": "import re, unicodedata\n\ndef norm(s):\n    s = unicodedata.normalize(\"NFKD\", s or \"\")\n    return \"\".join(ch for ch in s if not unicodedata.combining(ch)).lower()\n\ntext = norm($Card_Name)\nif not text.strip():\n    return []\n\nhits = []\n# Longest names first, so \"Sam Coffey\" wins over a separate \"Sam\"\nfor p in sorted(Players.all, key=lambda p: -len(p.Player_Name or \"\")):\n    n = norm(p.Player_Name).strip()\n    if not n:\n        continue\n    m = re.search(r\"(?<!\\w)\" + re.escape(n) + r\"(?!\\w)\", text)\n    if m:\n        hits.append((m.start(), p.id))\n        # blank out the match so a shorter name can't match inside it\n        text = text[:m.start()] + \" \" * (m.end() - m.start()) + text[m.end():]\n\n# return players in the order they appear on the card\nreturn [pid for _, pid in sorted(hits)]",
        "show_column": "Player_Name",
        "widget_options": {
          "widget": "Reference",
          "alignment": "left"
        }
      },
      {
        "id": "Team",
        "type": "Text",
        "kind": "data"
      },
      {
        "id": "Position",
        "type": "Text",
        "kind": "data"
      },
      {
        "id": "Card_Name",
        "type": "Text",
        "kind": "data",
        "label": "Card Name"
      },
      {
        "id": "Print_Run_Exceptions",
        "type": "RefList:PrintRunExceptions",
        "kind": "formula",
        "label": "Print Run Exceptions",
        "formula": "PrintRunExceptions.lookupRecords(Card_Key=$id)",
        "show_column": "Label"
      },
      {
        "id": "One_of_Ones",
        "type": "RefList:Parallels",
        "kind": "formula",
        "label": "One of Ones",
        "formula": "result = []\nfor p in Parallels.lookupRecords(Subset=$Subset):\n    exc = PrintRunExceptions.lookupOne(Card_Key=$id, Parallel_Key=p.id)\n    run = (None if exc.Not_Available else exc.Print_Run) if exc else p.Print_Run\n    if run == 1:\n        result.append(p.id)\nreturn result",
        "show_column": "Parallel"
      }
    ],
    "Parallels": [
      {
        "id": "Parallel_Key",
        "type": "Text",
        "kind": "formula",
        "label": "Parallel Key",
        "formula": "\"%s | %s\" % ($Subset.Subset, $Parallel)"
      },
